{
    "name": "decodelabs/coercion",
    "description": "Simple tools for managing PHP types",
    "type": "library",
    "keywords": [
        "type",
        "data",
        "structure"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Tom Wright",
            "email": "tom@inflatablecookie.com"
        }
    ],
    "require": {
        "php": "^8.4",

        "decodelabs/exceptional": "^0.6.3"
    },
    "require-dev": {
        "nesbot/carbon": "^3",

        "decodelabs/chorus": ">0",
        "decodelabs/phpstan-decodelabs": "^0.7"
    },
    "autoload": {
        "psr-4": {
            "DecodeLabs\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-develop": "0.3.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
